---
import Layout from '../layouts/Layout.astro';

const projekty = [
  {
    name: 'Urbalive by Plastia',
    url: 'www.urbalive.com',
    href: 'https://www.urbalive.com',
    perex: 'Přední výrobce pěstitelských a kompostovacích pomůcek a potřeb pro udržitelnou domácnost.',
    rok: '2025 – nyní',
    role: 'Web, Digitální marketing, Analýza, Grafika',
    img: '/images/urbalive-by-vondrakova.png',
    imgLeft: false,
  },
  {
    name: 'VyHUB',
    url: 'www.vyhub.cz',
    href: 'https://www.vyhub.cz',
    perex: 'Platforma pro udržitelné inovace na Vysočině. Ve spolupráci se SUSTO – Sustainability Tools ↗',
    rok: '2024 – nyní',
    role: 'Strategie, komunikace, PR, fundraising, produkce\nWeb',
    img: '/images/vyhub-kol-vondrakova.png',
    imgLeft: false,
  },
  {
    name: 'Brokis',
    url: 'www.configurator.brokis.com',
    href: 'https://configurator.brokis.com',
    perex: 'Konfigurátor designových světel do Janštejna. Ve spolupráci s GOAT LABS ↗',
    rok: '2023 – nyní',
    role: 'UX design',
    img: '/images/brokis-vondrakova-kom.png',
    imgLeft: true,
  },
  {
    name: 'HERO CLAN',
    url: 'www.heroclan.cz',
    href: 'https://www.heroclan.cz',
    perex: 'Neveřejná databáze kvalitních dobrovolníků na pomoc neziskovým organizacím. Spoluzaložila s Veronikou Kovářovou ↗',
    rok: '2017 – 2019',
    role: 'Spoluzakladatelka\nStrategie, komunikace, PR, fundraising, produkce\nSocial Impact Award 2017 – 1. místo\nCeny SDGs 2019 – 2. místo – Young Leader',
    img: '/images/heroclan.png',
    imgLeft: false,
  },
  {
    name: '#DoJihlavy',
    url: 'www.dojihlavy.cz',
    href: 'https://www.dojihlavy.cz',
    perex: 'Průvodce a komunita příznivců města Jihlavy. Je zamotaná s Místem Jihlava ↗ a s Lukášem Polívkou ↗',
    rok: '2011',
    role: 'Marketingová strategie\nKomunikace a PR\nVlastní webovka',
    img: '/images/dojihlavy.png',
    imgLeft: true,
  },
  {
    name: 'Silo Jihlava',
    url: 'www.silojihlava.cz',
    href: 'https://www.silojihlava.cz',
    perex: 'Kulturní a komunitní centrum v Jihlavě. Ve spolupráci s komunitou.',
    rok: '2020 – 2024',
    role: 'Spoluzakladatelka\nStrategie, komunikace, PR, fundraising, produkce',
    img: '/images/silo-jihlava.png',
    imgLeft: false,
  },
];

---

<Layout title="Portfolio služeb" description="Weby, service design, strategie — práce Kateřiny Vondráková.">

  <!-- Navrhuji a tvořím -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 60px 20px 40px;">
    <h1 style="font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 32px; color: #bc2938;">👩‍💻 Navrhuji a tvořím</h1>
    <div class="grid-3col" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px;">

      <div class="box-default">
        <h2 style="font-size: 1.3rem; margin: 0 0 12px;">Weby</h2>
        <p style="font-size: 14px; font-weight: 300; line-height: 1.6; margin: 0;">
          Navrhuji a stavím weby, které mají hlavu a patu. Kóduji s <strong style="font-weight: 500;">AI pomocníky</strong> — rychleji a přesněji. Musí být nejen krásné, ale hlavně přinášet výsledky.
        </p>
      </div>

      <div class="box-default">
        <h2 style="font-size: 1.3rem; margin: 0 0 12px;">Analýzy</h2>
        <p style="font-size: 14px; font-weight: 300; line-height: 1.6; margin: 0;">
          Opírám se o <strong style="font-weight: 500;">data</strong>. Propojuji weby s analytickými nástroji a sleduji, co skutečně funguje. Rozhodnutí zakládám na číslech, ne na pocitech.
        </p>
      </div>

      <div class="box-default">
        <h2 style="font-size: 1.3rem; margin: 0 0 12px;">Strategie</h2>
        <p style="font-size: 14px; font-weight: 300; line-height: 1.6; margin: 0;">
          Pomáhám najít cestu a <strong style="font-weight: 500;">vyhnout se slepým uličkám,</strong>
          které stojí čas a peníze. Čím víc energie do strategie, tím víc ušetříš v realizaci.
        </p>
      </div>

    </div>
    <p style="font-size: 15px; font-weight: 300; color: #bc2938; margin: 0 0 24px; max-width: 700px; line-height: 1.6;">
      Cena závisí na rozsahu spolupráce, vašich potřebách, termínu a jasnosti zadání.
      Veřejný ceník nemám — vše řeším individuálně.
    </p>
    <a href="/#spojme-se" class="btn-default">CHCI NEZÁVAZNOU KONZULTACI</a>
  </section>

  <!-- Práce, co mi dělá radost -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 80px 20px; border-top: 2px solid #bc2938;">
    <h2 style="font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 0 0 60px; color: #bc2938;">💡 Práce, co mi dělá radost</h2>

    {projekty.map((p) => (
      <div class="grid-2col" style={`display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 80px; direction: ${p.imgLeft ? 'rtl' : 'ltr'};`}>
        <div style="direction: ltr;">
          <img src={p.img} alt={p.name}
            style="width: 100%; border-radius: 8px;" />
        </div>
        <div style="direction: ltr;">
          <h3 style="font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0 0 8px; color: #bc2938;">{p.name}</h3>
          <p style="font-size: 13px; font-weight: 300; margin: 0 0 16px; color: #bc2938; opacity: 0.7;">{p.rok}</p>
          <p style="font-size: 15px; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0 0 16px;">{p.perex}</p>
          <p style="font-size: 13px; font-weight: 300; line-height: 1.6; color: #bc2938; white-space: pre-line; margin: 0 0 20px;">{p.role}</p>
          <a href={p.href} target="_blank" rel="noopener noreferrer" class="btn-default" style="font-size: 13px;">
            WWW.{p.url.toUpperCase().replace('WWW.', '')} →
          </a>
        </div>
      </div>
    ))}
  </section>

  <!-- A mnoho dalších -->
  <section style="max-width: 1100px; margin: 0 auto; padding: 40px 20px 80px; border-top: 2px solid #bc2938;">
    <h2 style="font-size: clamp(1.8rem, 3vw, 2.5rem); margin: 0 0 32px; color: #bc2938;">A mnoho dalších...</h2>
    <div style="display: inline-block; background: #ffffff; border: 2px solid #bc2938; border-radius: 16px; padding: 24px; max-width: 600px;">
      <img src="/images/loga_web_vondrakova.png" alt="Klienti: O2, A2, Knihlava, Brokis, Tassimo, ppm factum, ČDF, Chelsey Skills"
        style="width: 100%; display: block;" />
    </div>
  </section>

  <!-- Spojme se -->
  <section id="spojme-se" style="max-width: 1100px; margin: 0 auto; padding: 80px 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; border-top: 2px solid #bc2938;">
    <div>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 24px;">🤝 Spojme se</h2>
      <p style="font-size: 1rem; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0 0 32px;">
        Máte zájem spolupracovat? Pojďme si dát krátkou schůzku / call, kde se seznámíme a řekneme si,
        zda naše spolupráce dává smysl.
      </p>
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
        <img src="/images/katerina_foto.png" alt="Kateřina Vondráková"
          style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 2px solid #bc2938;" />
        <div>
          <p style="font-family: 'Abril Fatface', cursive, serif; font-size: 1.1rem; color: #bc2938; margin: 0 0 4px;">Ing. Kateřina Vondráková</p>
          <p style="margin: 2px 0; font-size: 14px; font-weight: 300;">
            <a href="mailto:zeptamse@kateriny.cz" style="color: #bc2938;">zeptamse@kateriny.cz</a>
          </p>
          <p style="margin: 2px 0; font-size: 14px; font-weight: 300;">
            <a href="tel:+420721408001" style="color: #bc2938;">+420 721 408 001</a>
          </p>
        </div>
      </div>
      <div style="display: flex; gap: 12px;">
        <a href="https://www.linkedin.com/in/katerina-vondrakova/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://www.instagram.com/kateriny.cz/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
        </a>
        <a href="https://www.facebook.com/kateriny.tecka/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
      </div>
    </div>
    <div></div>
  </section>

</Layout>

<style>
  @media (max-width: 767px) {
    section[style*="grid-template-columns: repeat(3, 1fr)"],
    section[style*="grid-template-columns: 1fr 1fr"] {
      /* handled inline for project grids */
    }
    div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      direction: ltr !important;
    }
  }
</style>
