---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Weby" description="Weby, které fungují — krásné i výkonné.">

  <section style="max-width: 1360px; margin: 0 auto; padding: 60px 20px 40px;">
    <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); margin: 0 0 24px; color: #bc2938;">Weby, které fungují</h1>
    <p style="font-size: 1.1rem; font-weight: 300; max-width: 700px; line-height: 1.7; color: #bc2938; margin: 0;">
      Krásný web nestačí. Musí přivádět zákazníky, sdělovat hodnotu a dávat smysl.
    </p>
  </section>

  <section style="max-width: 1360px; margin: 0 auto; padding: 40px 20px; border-top: 2px solid #bc2938;">
    <div class="grid-2col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
      <div class="box-default">
        <h2 style="font-size: 1.3rem; margin: 0 0 16px;">Jak pracuju</h2>
        <p style="font-size: 15px; font-weight: 300; line-height: 1.7; margin: 0;">
          Stavím weby na české platformě <a href="https://www.solidpixels.com" target="_blank" rel="noopener" style="color: #bc2938;"><strong style="font-weight: 500;">solidpixels.</strong> ↗</a>,
          která spojuje estetiku s maximální funkčností — a je volbou č. 1 pro mě, prezidenta Pavla, DOX a další.
          Klient po předání nepotřebuje programátora — obsah si spravuje sám, jednoduše a bezpečně.
        </p>
      </div>
      <div class="box-default">
        <h2 style="font-size: 1.3rem; margin: 0 0 16px;">Co dostaneš</h2>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; font-weight: 300; line-height: 1.5; color: #bc2938;">
          <li>✓ Analýza potřeb a cílové skupiny</li>
          <li>✓ Návrh struktury a obsahu</li>
          <li>✓ Grafický design na míru</li>
          <li>✓ Implementace a testování</li>
          <li>✓ Předání s instrukcemi</li>
          <li>✓ Podpora po spuštění</li>
        </ul>
      </div>
    </div>
  </section>

  <section style="max-width: 1360px; margin: 0 auto; padding: 40px 20px 80px; border-top: 2px solid #bc2938;">
    <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 32px; color: #bc2938;">Ukázkové projekty</h2>
    <div class="grid-3col" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px;">
      {[
        { name: 'Silo Jihlava',  href: 'https://www.silojihlava.cz',  url: 'silojihlava.cz',  desc: 'Komunitní a kulturní centrum Jihlava' },
        { name: 'VyHUB',         href: 'https://www.vyhub.cz',         url: 'vyhub.cz',         desc: 'Platforma udržitelných inovací Vysočina' },
        { name: 'Do Jihlavy',    href: 'https://www.dojihlavy.cz',     url: 'dojihlavy.cz',     desc: 'Průvodce městem #DoJihlavy' },
      ].map(({ name, href, url, desc }) => (
        <div class="box-default">
          <h3 style="font-size: 1.1rem; margin: 0 0 8px;">{name}</h3>
          <p style="font-size: 13px; color: #bc2938; opacity: 0.7; margin: 0 0 8px;">{url}</p>
          <p style="font-size: 14px; font-weight: 300; margin: 0 0 16px;">{desc}</p>
          <a href={href} target="_blank" rel="noopener noreferrer" class="btn-default" style="font-size: 13px;">Navštívit →</a>
        </div>
      ))}
    </div>
    <a href="/kontakt" class="btn-primary">Chci web →</a>
  </section>

</Layout>
