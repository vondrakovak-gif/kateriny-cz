---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt" description="Napište mi nebo si domluvme krátký call.">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-8">
    <p class="text-sm font-medium text-brand-600 uppercase tracking-widest mb-4">Kontakt</p>
    <h1 class="text-4xl md:text-5xl font-light mb-6">Pojďme si promluvit</h1>
    <p class="text-xl text-gray-500 max-w-2xl">
      Krátký úvodní call zdarma — zjistíme, jestli spolupráce dává smysl.
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-6 py-12 border-t border-gray-100">
    <div class="space-y-4 max-w-sm">
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">E-mail</p>
        <a href="mailto:zeptamse@kateriny.cz" class="text-brand-600 hover:underline">
          zeptamse@kateriny.cz
        </a>
      </div>
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Telefon</p>
        <a href="tel:+420721408001" class="text-brand-600 hover:underline">
          +420 721 408 001
        </a>
      </div>
      <div>
        <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Lokalita</p>
        <p class="text-gray-700">Jihlava · Česká republika</p>
      </div>
    </div>
  </section>
</Layout>
