---
export const prerender = false;
import FakturaceLayout from '../../layouts/FakturaceLayout.astro';
import { getFaktury } from '../../lib/fakturace/kv';
import { getDodavatel } from '../../lib/fakturace/dodavatel';

const dodavatel = getDodavatel();

const rok = new Date().getFullYear();
let nextNum = 1;
try {
  const faktury = await getFaktury();
  const letosni = faktury.filter(f => f.cislo.startsWith(`${rok}-`));
  if (letosni.length > 0) {
    const max = Math.max(...letosni.map(f => parseInt(f.cislo.split('-')[1] ?? '0') || 0));
    nextNum = max + 1;
  }
} catch {}

const nextCislo = `${rok}-${String(nextNum).padStart(4, '0')}`;
const nextVS = `${rok}${String(nextNum).padStart(4, '0')}`;
const dnes = new Date().toISOString().split('T')[0];
const splatnost = new Date(Date.now() + 14 * 86400000).toISOString().split('T')[0];
---
<FakturaceLayout title="Nová faktura">
  <div style="max-width:820px;margin:0 auto;padding:24px 20px;">

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
      <a href="/fakturace" style="color:#888;font-size:14px;">← Zpět</a>
      <h1 style="font-size:22px;font-weight:600;">Nová faktura</h1>
    </div>

    <form id="fakturaForm" method="POST" action="/api/fakturace/vytvor">

      <!-- Základní info -->
      <div class="card" style="margin-bottom:16px;">
        <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px;">Základní informace</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;">
          <div>
            <label>Číslo faktury</label>
            <input type="text" name="cislo" value={nextCislo} required />
          </div>
          <div>
            <label>Variabilní symbol</label>
            <input type="text" name="variabilniSymbol" id="variabilniSymbol" value={nextVS} required />
          </div>
          <div>
            <label>Datum vystavení</label>
            <input type="date" name="datum" value={dnes} required />
          </div>
          <div>
            <label>Datum splatnosti</label>
            <input type="date" name="datumSplatnosti" value={splatnost} required />
          </div>
        </div>
      </div>

      <!-- Klient -->
      <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;">Odběratel</h2>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="text" id="icoSearch" placeholder="Hledat dle IČO" style="width:150px;" />
            <button type="button" id="aresBtn" class="btn btn-outline btn-sm">Najít v ARES</button>
            <span id="aresStatus" style="font-size:13px;color:#888;display:none;"></span>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="grid-column:1/-1;">
            <label>Název firmy / jméno</label>
            <input type="text" name="klientNazev" id="klientNazev" required />
          </div>
          <div>
            <label>IČO</label>
            <input type="text" name="klientIco" id="klientIco" />
          </div>
          <div>
            <label>DIČ</label>
            <input type="text" name="klientDic" id="klientDic" />
          </div>
          <div style="grid-column:1/-1;">
            <label>Adresa</label>
            <input type="text" name="klientAdresa" id="klientAdresa" required />
          </div>
          <div style="grid-column:1/-1;">
            <label>E-mail (nepovinné)</label>
            <input type="email" name="klientEmail" />
          </div>
        </div>
      </div>

      <!-- Položky -->
      <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;">Položky</h2>
          <button type="button" id="pridatPolozku" class="btn btn-outline btn-sm">+ Přidat položku</button>
        </div>
        <div id="polozky">
          <div class="polozka" style="display:grid;grid-template-columns:3fr 1fr 1fr 1.2fr auto;gap:10px;align-items:end;margin-bottom:10px;">
            <div><label>Popis</label><input type="text" name="popis[]" required /></div>
            <div><label>Množství</label><input type="number" name="mnozstvi[]" value="1" min="0.01" step="0.01" required class="mnozstvi" /></div>
            <div><label>Jednotka</label><input type="text" name="jednotka[]" value="hod" /></div>
            <div><label>Cena/j. (Kč)</label><input type="number" name="cenaJednotka[]" min="0" step="0.01" required class="cenaJednotka" /></div>
            <div><button type="button" class="smazatPolozku btn btn-sm" style="background:#fde8ea;color:#bc2938;margin-top:20px;border:none;" disabled>✕</button></div>
          </div>
        </div>
        <div style="border-top:1.5px solid #f0ebe5;margin-top:12px;padding-top:14px;display:flex;justify-content:space-between;align-items:center;">
          <div style="font-size:13px;color:#888;">
            DPH:
            <select name="dph" id="dphSelect" style="display:inline-block;width:auto;padding:4px 8px;margin-left:6px;">
              <option value="0">0% (neplátce)</option>
              <option value="12">12%</option>
              <option value="21">21%</option>
            </select>
          </div>
          <div style="font-size:18px;font-weight:700;color:#bc2938;">
            Celkem: <span id="celkemDisplay">0 Kč</span>
          </div>
        </div>
      </div>

      <!-- Poznámka -->
      <div class="card" style="margin-bottom:20px;">
        <label>Poznámka (nepovinné)</label>
        <textarea name="poznamka" rows="2" style="resize:vertical;margin-top:4px;"></textarea>
      </div>

      <input type="hidden" name="celkemBezDph" id="celkemBezDph" />
      <input type="hidden" name="celkemSDph" id="celkemSDph" />

      <div style="display:flex;gap:12px;justify-content:flex-end;">
        <a href="/fakturace" class="btn btn-outline">Zrušit</a>
        <button type="submit" class="btn btn-primary">Vytvořit fakturu</button>
      </div>
    </form>
  </div>

  <script>
    // Variabilní symbol se generuje z čísla faktury
    document.querySelector('[name="cislo"]')?.addEventListener('input', function(this: HTMLInputElement) {
      const vs = this.value.replace(/\D/g, '');
      (document.getElementById('variabilniSymbol') as HTMLInputElement).value = vs;
    });

    // ARES
    document.getElementById('aresBtn')?.addEventListener('click', async () => {
      const ico = (document.getElementById('icoSearch') as HTMLInputElement).value.trim();
      if (!ico) return;
      const status = document.getElementById('aresStatus')!;
      status.style.display = 'inline';
      status.style.color = '#888';
      status.textContent = 'Hledám…';
      try {
        const res = await fetch(`/api/fakturace/ares?ico=${encodeURIComponent(ico)}`);
        const data = await res.json();
        if (data.error) { status.textContent = `⚠️ ${data.error}`; return; }
        (document.getElementById('klientNazev') as HTMLInputElement).value = data.nazev ?? '';
        (document.getElementById('klientIco') as HTMLInputElement).value = data.ico ?? '';
        (document.getElementById('klientDic') as HTMLInputElement).value = data.dic ?? '';
        (document.getElementById('klientAdresa') as HTMLInputElement).value = data.adresa ?? '';
        status.textContent = '✓ Nalezeno';
        status.style.color = '#16a34a';
      } catch { status.textContent = '⚠️ Chyba'; }
    });

    // Přidat/smazat položku
    function updateDeleteBtns() {
      const btns = document.querySelectorAll<HTMLButtonElement>('.smazatPolozku');
      btns.forEach(b => b.disabled = btns.length === 1);
    }
    document.getElementById('pridatPolozku')?.addEventListener('click', () => {
      const container = document.getElementById('polozky')!;
      const clone = (container.querySelector('.polozka') as HTMLElement).cloneNode(true) as HTMLElement;
      clone.querySelectorAll('input').forEach(i => {
        if (i.name === 'mnozstvi[]') i.value = '1';
        else if (i.name === 'jednotka[]') i.value = 'hod';
        else i.value = '';
      });
      clone.querySelector('.smazatPolozku')?.addEventListener('click', function(this: HTMLElement) {
        this.closest('.polozka')?.remove(); updateDeleteBtns(); vypocitej();
      });
      container.appendChild(clone);
      updateDeleteBtns();
    });
    document.querySelector('.smazatPolozku')?.addEventListener('click', function(this: HTMLElement) {
      this.closest('.polozka')?.remove(); updateDeleteBtns(); vypocitej();
    });

    // Výpočet
    function vypocitej() {
      let suma = 0;
      document.querySelectorAll('.polozka').forEach(p => {
        const m = parseFloat((p.querySelector('.mnozstvi') as HTMLInputElement).value) || 0;
        const c = parseFloat((p.querySelector('.cenaJednotka') as HTMLInputElement).value) || 0;
        suma += m * c;
      });
      const dph = parseFloat((document.getElementById('dphSelect') as HTMLSelectElement).value) || 0;
      const sDph = suma * (1 + dph / 100);
      document.getElementById('celkemDisplay')!.textContent =
        new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 2 }).format(sDph) + ' Kč';
      (document.getElementById('celkemBezDph') as HTMLInputElement).value = String(Math.round(suma * 100) / 100);
      (document.getElementById('celkemSDph') as HTMLInputElement).value = String(Math.round(sDph * 100) / 100);
    }
    document.getElementById('polozky')!.addEventListener('input', vypocitej);
    document.getElementById('dphSelect')!.addEventListener('change', vypocitej);
  </script>
</FakturaceLayout>
