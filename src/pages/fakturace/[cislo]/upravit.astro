---
export const prerender = false;
import FakturaceLayout from '../../../layouts/FakturaceLayout.astro';
import { getFaktura } from '../../../lib/fakturace/kv';

const { cislo } = Astro.params;
const faktura = cislo ? await getFaktura(decodeURIComponent(cislo)) : null;
if (!faktura) return Astro.redirect('/fakturace');

function fmtNum(n: number) { return String(n).replace('.', ','); }
---
<FakturaceLayout title={`Upravit ${faktura.cislo}`}>
  <div style="max-width:820px;margin:0 auto;padding:24px 20px;">

    <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;">
      <a href={`/fakturace/${faktura.cislo}`} style="color:#888;font-size:14px;">← Zpět</a>
      <h1 style="font-size:22px;font-weight:600;">Upravit fakturu {faktura.cislo}</h1>
    </div>

    <form method="POST" action="/api/fakturace/uprav">
      <input type="hidden" name="puvodniCislo" value={faktura.cislo} />

      <div class="card" style="margin-bottom:16px;">
        <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px;">Základní informace</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;">
          <div>
            <label>Číslo faktury</label>
            <input type="text" name="cislo" value={faktura.cislo} required />
          </div>
          <div>
            <label>Variabilní symbol</label>
            <input type="text" name="variabilniSymbol" value={faktura.variabilniSymbol} required />
          </div>
          <div>
            <label>Datum vystavení</label>
            <input type="date" name="datum" value={faktura.datum} required />
          </div>
          <div>
            <label>Datum splatnosti</label>
            <input type="date" name="datumSplatnosti" value={faktura.datumSplatnosti} required />
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px;">Odběratel</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
          <div style="grid-column:1/-1;">
            <label>Název firmy / jméno</label>
            <input type="text" name="klientNazev" value={faktura.klient.nazev} required />
          </div>
          <div><label>IČO</label><input type="text" name="klientIco" value={faktura.klient.ico} /></div>
          <div><label>DIČ</label><input type="text" name="klientDic" value={faktura.klient.dic ?? ''} /></div>
          <div style="grid-column:1/-1;"><label>Adresa</label><input type="text" name="klientAdresa" value={faktura.klient.adresa} required /></div>
          <div style="grid-column:1/-1;"><label>E-mail</label><input type="email" name="klientEmail" value={faktura.klient.email ?? ''} /></div>
        </div>
      </div>

      <div class="card" style="margin-bottom:16px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;">Položky</h2>
          <button type="button" id="pridatPolozku" class="btn btn-outline btn-sm">+ Přidat</button>
        </div>
        <div id="polozky">
          {faktura.polozky.map((p, i) => (
            <div class="polozka" style="display:grid;grid-template-columns:3fr 1fr 1fr 1.2fr auto;gap:10px;align-items:end;margin-bottom:10px;">
              <div><label>Popis</label><input type="text" name="popis[]" value={p.popis} required /></div>
              <div><label>Množství</label><input type="number" name="mnozstvi[]" value={p.mnozstvi} min="0.01" step="0.01" required class="mnozstvi" /></div>
              <div><label>Jednotka</label><input type="text" name="jednotka[]" value={p.jednotka} /></div>
              <div><label>Cena/j. (Kč)</label><input type="number" name="cenaJednotka[]" value={p.cenaJednotka} min="0" step="0.01" required class="cenaJednotka" /></div>
              <div><button type="button" class="smazatPolozku btn btn-sm" style="background:#fde8ea;color:#bc2938;margin-top:20px;border:none;" disabled={faktura.polozky.length === 1}>✕</button></div>
            </div>
          ))}
        </div>
        <div style="border-top:1.5px solid #f0ebe5;margin-top:12px;padding-top:14px;display:flex;justify-content:space-between;align-items:center;">
          <div style="font-size:13px;color:#888;">
            DPH:
            <select name="dph" id="dphSelect" style="display:inline-block;width:auto;padding:4px 8px;margin-left:6px;">
              <option value="0" selected={faktura.dph === 0}>0% (neplátce)</option>
              <option value="12" selected={faktura.dph === 12}>12%</option>
              <option value="21" selected={faktura.dph === 21}>21%</option>
            </select>
          </div>
          <div style="font-size:18px;font-weight:700;color:#bc2938;">
            Celkem: <span id="celkemDisplay">{new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 2 }).format(faktura.celkemSDph)} Kč</span>
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:20px;">
        <label>Poznámka</label>
        <textarea name="poznamka" rows="2" style="resize:vertical;margin-top:4px;">{faktura.poznamka}</textarea>
      </div>

      <input type="hidden" name="celkemBezDph" id="celkemBezDph" value={faktura.celkemBezDph} />
      <input type="hidden" name="celkemSDph" id="celkemSDph" value={faktura.celkemSDph} />

      <div style="display:flex;gap:12px;justify-content:space-between;">
        <button type="button" id="smazatBtn" class="btn btn-sm" style="background:#fde8ea;color:#bc2938;border:none;">Smazat fakturu</button>
        <div style="display:flex;gap:12px;">
          <a href={`/fakturace/${faktura.cislo}`} class="btn btn-outline">Zrušit</a>
          <button type="submit" class="btn btn-primary">Uložit změny</button>
        </div>
      </div>
    </form>

    <form id="smazatForm" method="POST" action="/api/fakturace/smaz" style="display:none;">
      <input type="hidden" name="cislo" value={faktura.cislo} />
    </form>
  </div>

  <script>
    document.getElementById('smazatBtn')?.addEventListener('click', () => {
      if (confirm('Opravdu smazat tuto fakturu? Tato akce je nevratná.')) {
        (document.getElementById('smazatForm') as HTMLFormElement).submit();
      }
    });

    function updateDeleteBtns() {
      const btns = document.querySelectorAll<HTMLButtonElement>('.smazatPolozku');
      btns.forEach(b => b.disabled = btns.length === 1);
    }
    document.getElementById('pridatPolozku')?.addEventListener('click', () => {
      const container = document.getElementById('polozky')!;
      const clone = (container.querySelector('.polozka') as HTMLElement).cloneNode(true) as HTMLElement;
      clone.querySelectorAll('input').forEach(i => {
        if (i.name === 'mnozstvi[]') i.value = '1';
        else if (i.name === 'jednotka[]') i.value = 'hod';
        else i.value = '';
      });
      clone.querySelector('.smazatPolozku')?.addEventListener('click', function(this: HTMLElement) {
        this.closest('.polozka')?.remove(); updateDeleteBtns(); vypocitej();
      });
      container.appendChild(clone);
      updateDeleteBtns();
    });
    document.querySelectorAll('.smazatPolozku').forEach(b =>
      b.addEventListener('click', function(this: HTMLElement) {
        this.closest('.polozka')?.remove(); updateDeleteBtns(); vypocitej();
      })
    );
    function vypocitej() {
      let suma = 0;
      document.querySelectorAll('.polozka').forEach(p => {
        const m = parseFloat((p.querySelector('.mnozstvi') as HTMLInputElement).value) || 0;
        const c = parseFloat((p.querySelector('.cenaJednotka') as HTMLInputElement).value) || 0;
        suma += m * c;
      });
      const dph = parseFloat((document.getElementById('dphSelect') as HTMLSelectElement).value) || 0;
      const sDph = suma * (1 + dph / 100);
      document.getElementById('celkemDisplay')!.textContent = new Intl.NumberFormat('cs-CZ', { maximumFractionDigits: 2 }).format(sDph) + ' Kč';
      (document.getElementById('celkemBezDph') as HTMLInputElement).value = String(Math.round(suma * 100) / 100);
      (document.getElementById('celkemSDph') as HTMLInputElement).value = String(Math.round(sDph * 100) / 100);
    }
    document.getElementById('polozky')!.addEventListener('input', vypocitej);
    document.getElementById('dphSelect')!.addEventListener('change', vypocitej);
  </script>
</FakturaceLayout>
