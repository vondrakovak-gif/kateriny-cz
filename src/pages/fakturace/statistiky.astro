---
export const prerender = false;
import FakturaceLayout from '../../layouts/FakturaceLayout.astro';
import { getFaktury } from '../../lib/fakturace/kv';
import type { Faktura } from '../../lib/fakturace/types';

const rokParam = Astro.url.searchParams.get('rok');
const aktualniRok = new Date().getFullYear();
const rok = rokParam ? parseInt(rokParam) : aktualniRok;

let vsechneFaktury: Faktura[] = [];
let chyba = '';

try {
  vsechneFaktury = await getFaktury();
} catch {
  chyba = 'Vercel KV není propojeno.';
}

const roky = [...new Set(vsechneFaktury.map(f => f.datum?.substring(0, 4)).filter(Boolean))].sort((a, b) => b.localeCompare(a));
if (!roky.includes(String(rok))) roky.unshift(String(rok));

const faktury = vsechneFaktury.filter(f => f.datum?.startsWith(String(rok)));

const mesice = Array.from({ length: 12 }, (_, i) => {
  const m = String(i + 1).padStart(2, '0');
  const mF = faktury.filter(f => f.datum?.startsWith(`${rok}-${m}`));
  return {
    nazev: new Date(rok, i, 1).toLocaleDateString('cs-CZ', { month: 'long' }),
    celkem: mF.reduce((s, f) => s + f.celkemSDph, 0),
    zaplaceno: mF.filter(f => f.zaplaceno).reduce((s, f) => s + f.celkemSDph, 0),
    pocet: mF.length,
  };
});

const klienti = Object.values(
  faktury.reduce((acc, f) => {
    const k = f.klient.nazev;
    if (!acc[k]) acc[k] = { nazev: k, celkem: 0, pocet: 0 };
    acc[k].celkem += f.celkemSDph;
    acc[k].pocet += 1;
    return acc;
  }, {} as Record<string, { nazev: string; celkem: number; pocet: number }>)
).sort((a, b) => b.celkem - a.celkem);

const celkemRok = faktury.reduce((s, f) => s + f.celkemSDph, 0);
const zaplaceno = faktury.filter(f => f.zaplaceno).reduce((s, f) => s + f.celkemSDph, 0);
const nezaplaceno = celkemRok - zaplaceno;
const maxMesic = Math.max(...mesice.map(m => m.celkem), 1);

function fmt(c: number) {
  return new Intl.NumberFormat('cs-CZ', { style: 'currency', currency: 'CZK', maximumFractionDigits: 0 }).format(c);
}
---
<FakturaceLayout title={`Statistiky ${rok}`}>
  <div style="max-width:1000px;margin:0 auto;padding:24px 20px;">

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;">
      <div style="display:flex;align-items:center;gap:16px;">
        <a href="/fakturace" style="color:#888;font-size:14px;">← Zpět</a>
        <h1 style="font-size:22px;font-weight:600;">Statistiky {rok}</h1>
      </div>
      <div style="display:flex;gap:6px;">
        {roky.map(r => (
          <a href={`/fakturace/statistiky?rok=${r}`}
             style={`padding:5px 12px;border-radius:6px;font-size:13px;font-weight:500;text-decoration:none;${r === String(rok) ? 'background:#bc2938;color:#fff;' : 'background:#f0ebe5;color:#555;'}`}>
            {r}
          </a>
        ))}
      </div>
    </div>

    {chyba && <div style="background:#fde8ea;padding:14px;border-radius:8px;margin-bottom:16px;">{chyba}</div>}

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px;">
      <div class="card">
        <div style="font-size:12px;color:#888;margin-bottom:4px;">Celkový obrat {rok}</div>
        <div style="font-size:20px;font-weight:700;color:#bc2938;">{fmt(celkemRok)}</div>
      </div>
      <div class="card">
        <div style="font-size:12px;color:#888;margin-bottom:4px;">Zaplaceno</div>
        <div style="font-size:20px;font-weight:700;color:#16a34a;">{fmt(zaplaceno)}</div>
      </div>
      <div class="card">
        <div style="font-size:12px;color:#888;margin-bottom:4px;">Čeká na platbu</div>
        <div style="font-size:20px;font-weight:700;" style={`color:${nezaplaceno > 0 ? '#d97706' : '#16a34a'}`}>{fmt(nezaplaceno)}</div>
      </div>
      <div class="card">
        <div style="font-size:12px;color:#888;margin-bottom:4px;">Počet faktur</div>
        <div style="font-size:20px;font-weight:700;">{faktury.length}</div>
      </div>
    </div>

    <!-- Graf -->
    <div class="card" style="margin-bottom:28px;">
      <h2 style="font-size:15px;font-weight:600;margin-bottom:20px;">Obrat po měsících</h2>
      <div style="display:flex;align-items:flex-end;gap:6px;height:150px;">
        {mesice.map(m => (
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;">
            {m.celkem > 0 && (
              <div style="font-size:9px;color:#888;writing-mode:vertical-rl;transform:rotate(180deg);height:30px;overflow:hidden;">
                {fmt(m.celkem)}
              </div>
            )}
            <div style={`width:100%;border-radius:4px 4px 0 0;background:#bc2938;opacity:${m.celkem > 0 ? 1 : 0.1};height:${Math.max(Math.round((m.celkem / maxMesic) * 110), m.celkem > 0 ? 4 : 2)}px;`}></div>
            <div style="font-size:10px;color:#888;">{m.nazev.substring(0,3)}</div>
            {m.pocet > 0 && <div style="font-size:9px;color:#bbb;">{m.pocet}×</div>}
          </div>
        ))}
      </div>
    </div>

    {klienti.length > 0 && (
      <div class="card">
        <h2 style="font-size:15px;font-weight:600;margin-bottom:16px;">Klienti {rok}</h2>
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:2px solid #f0ebe5;">
              <th style="text-align:left;padding:8px 0;font-size:12px;color:#888;font-weight:600;">Klient</th>
              <th style="text-align:right;padding:8px 0;font-size:12px;color:#888;font-weight:600;">Faktur</th>
              <th style="text-align:right;padding:8px 0;font-size:12px;color:#888;font-weight:600;">Celkem</th>
              <th style="text-align:right;padding:8px 0;font-size:12px;color:#888;font-weight:600;">Podíl</th>
            </tr>
          </thead>
          <tbody>
            {klienti.map(k => (
              <tr style="border-bottom:1px solid #f0ebe5;">
                <td style="padding:10px 0;font-weight:500;">{k.nazev}</td>
                <td style="padding:10px 0;text-align:right;color:#666;">{k.pocet}</td>
                <td style="padding:10px 0;text-align:right;font-weight:500;">{fmt(k.celkem)}</td>
                <td style="padding:10px 0;text-align:right;color:#666;">
                  {celkemRok > 0 ? Math.round(k.celkem / celkemRok * 100) : 0} %
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</FakturaceLayout>
