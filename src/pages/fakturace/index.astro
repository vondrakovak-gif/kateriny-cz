---
export const prerender = false;
import FakturaceLayout from '../../layouts/FakturaceLayout.astro';
import { getFaktury } from '../../lib/fakturace/sheets';
import type { Faktura } from '../../lib/fakturace/types';

let faktury: Faktura[] = [];
let chyba = '';

try {
  faktury = await getFaktury();
} catch (e) {
  chyba = 'Google Sheets není propojeno. Nastav GOOGLE_* proměnné v .env';
}

faktury.sort((a, b) => b.cislo.localeCompare(a.cislo));

const rok = new Date().getFullYear();
const letosniFaktury = faktury.filter(f => f.datum.startsWith(String(rok)));
const celkemLetos = letosniFaktury.reduce((s, f) => s + f.celkemSDph, 0);
const nezaplaceno = faktury.filter(f => !f.zaplaceno).reduce((s, f) => s + f.celkemSDph, 0);

function formatCastka(c: number) {
  return new Intl.NumberFormat('cs-CZ', { style: 'currency', currency: 'CZK', maximumFractionDigits: 0 }).format(c);
}
function formatDatum(d: string) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('cs-CZ');
}
---
<FakturaceLayout title="Přehled faktur">
  <div style="max-width:1100px;margin:0 auto;padding:24px 20px;">

    <!-- Header -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;">
      <h1 style="font-size:24px;font-weight:600;">Fakturace</h1>
      <div style="display:flex;gap:10px;">
        <a href="/fakturace/nova" class="btn btn-primary">+ Nová faktura</a>
        <a href="/fakturace/statistiky" class="btn btn-outline">Statistiky</a>
        <a href="/api/fakturace/logout" class="btn btn-outline btn-sm" style="color:#888;border-color:#ccc;">Odhlásit</a>
      </div>
    </div>

    {chyba && (
      <div style="background:#fff8e1;border:1.5px solid #f0b429;border-radius:8px;padding:14px 18px;margin-bottom:20px;font-size:14px;color:#7a5100;">
        ⚠️ {chyba}
      </div>
    )}

    <!-- Statistiky nahoře -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:28px;">
      <div class="card">
        <div style="font-size:13px;color:#888;margin-bottom:4px;">Celkem {rok}</div>
        <div style="font-size:22px;font-weight:600;color:#bc2938;">{formatCastka(celkemLetos)}</div>
      </div>
      <div class="card">
        <div style="font-size:13px;color:#888;margin-bottom:4px;">Nezaplaceno</div>
        <div style="font-size:22px;font-weight:600;color:{nezaplaceno > 0 ? '#d97706' : '#16a34a'};">{formatCastka(nezaplaceno)}</div>
      </div>
      <div class="card">
        <div style="font-size:13px;color:#888;margin-bottom:4px;">Počet faktur {rok}</div>
        <div style="font-size:22px;font-weight:600;">{letosniFaktury.length}</div>
      </div>
    </div>

    <!-- Tabulka faktur -->
    <div class="card" style="padding:0;overflow:hidden;">
      {faktury.length === 0 && !chyba ? (
        <div style="padding:40px;text-align:center;color:#888;">
          Zatím žádné faktury. <a href="/fakturace/nova">Vytvoř první fakturu →</a>
        </div>
      ) : (
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:2px solid #f0ebe5;background:#faf8f5;">
              <th style="padding:12px 16px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Číslo</th>
              <th style="padding:12px 16px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Klient</th>
              <th style="padding:12px 16px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Datum</th>
              <th style="padding:12px 16px;text-align:left;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Splatnost</th>
              <th style="padding:12px 16px;text-align:right;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Částka</th>
              <th style="padding:12px 16px;text-align:center;font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Stav</th>
              <th style="padding:12px 16px;"></th>
            </tr>
          </thead>
          <tbody>
            {faktury.map((f, i) => (
              <tr style={`border-bottom:1px solid #f0ebe5;${i % 2 === 0 ? '' : 'background:#fdfcfb;'}`}>
                <td style="padding:12px 16px;font-weight:500;">{f.cislo}</td>
                <td style="padding:12px 16px;">{f.klient.nazev}</td>
                <td style="padding:12px 16px;color:#666;">{formatDatum(f.datum)}</td>
                <td style="padding:12px 16px;color:#666;">{formatDatum(f.datumSplatnosti)}</td>
                <td style="padding:12px 16px;text-align:right;font-weight:500;">{formatCastka(f.celkemSDph)}</td>
                <td style="padding:12px 16px;text-align:center;">
                  <form method="POST" action="/api/fakturace/zaplaceno" style="display:inline;">
                    <input type="hidden" name="cislo" value={f.cislo} />
                    <input type="hidden" name="zaplaceno" value={f.zaplaceno ? 'false' : 'true'} />
                    <button type="submit" class="btn btn-sm" style={`border:none;border-radius:20px;padding:4px 12px;font-size:12px;cursor:pointer;${f.zaplaceno ? 'background:#dcfce7;color:#16a34a;' : 'background:#fef3c7;color:#d97706;'}`}>
                      {f.zaplaceno ? '✓ Zaplaceno' : '⏳ Čeká'}
                    </button>
                  </form>
                </td>
                <td style="padding:12px 16px;">
                  <div style="display:flex;gap:8px;">
                    <a href={`/fakturace/${f.cislo}`} class="btn btn-outline btn-sm">Detail</a>
                    <a href={`/api/fakturace/pdf?cislo=${f.cislo}`} class="btn btn-sm" style="background:#f0ebe5;color:#555;" target="_blank">PDF</a>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</FakturaceLayout>
