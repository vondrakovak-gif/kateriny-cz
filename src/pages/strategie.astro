---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strategie" description="Čím víc energie vložíš do strategie, tím víc ušetříš v realizaci.">

  <section style="max-width: 1360px; margin: 0 auto; padding: 60px 20px 40px;">
    <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); margin: 0 0 24px; color: #bc2938;">Strategie projektu</h1>
    <p style="font-size: 1.1rem; font-weight: 300; max-width: 700px; line-height: 1.7; color: #bc2938; margin: 0;">
      Čím víc energie vložíš do strategie, tím víc ušetříš v realizaci — a vyhnout se slepým uličkám,
      které stojí čas i peníze.
    </p>
  </section>

  <section style="max-width: 1360px; margin: 0 auto; padding: 40px 20px; border-top: 2px solid #bc2938;">
    <div class="grid-3col" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
      {[
        {
          title: 'Kde jsi',
          desc: 'Analýza aktuálního stavu — produkt, trh, zákazníci, konkurence, silné a slabé stránky.',
        },
        {
          title: 'Kam chceš',
          desc: 'Definice cílů, vizí a priorit. Co musí být hotovo za rok, za půl roku, za měsíc?',
        },
        {
          title: 'Jak se tam dostaneš',
          desc: 'Konkrétní cestovní mapa s kroky, milníky a způsobem měření úspěchu.',
        },
      ].map(({ title, desc }) => (
        <div class="box-default">
          <h3 style="font-size: 1.1rem; margin: 0 0 12px;">{title}</h3>
          <p style="font-size: 14px; font-weight: 300; line-height: 1.6; margin: 0;">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="max-width: 1360px; margin: 0 auto; padding: 40px 20px 80px; border-top: 2px solid #bc2938;">
    <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 24px; color: #bc2938;">Pro koho to je</h2>
    <div class="grid-2col" style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-bottom: 40px;">
      <p style="font-size: 15px; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0;">
        Projekty, které mají nápad, ale nevědí kudy dál. Firmy, které cítí, že něco nefunguje,
        ale neumí pojmenovat co. Founders na začátku, kteří chtějí šlápnout správnou nohou.
      </p>
      <p style="font-size: 15px; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0;">
        Zaměřuji se na projekty s přesahem — v oblasti kultury, komunit, vzdělávání,
        udržitelnosti a sociální inovace.
      </p>
    </div>
    <a href="/kontakt" class="btn-primary">Domluvit konzultaci →</a>
  </section>

</Layout>
