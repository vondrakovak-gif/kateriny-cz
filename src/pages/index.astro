---
import Layout from '../layouts/Layout.astro';

const slides = [
  { src: '/images/VyHUB_web_by_Katerina_Vondrakova.png', alt: 'VyHUB' },
  { src: '/images/BROKIS_vondráková_2.png', alt: 'Brokis' },
  { src: '/images/Skala_web_by_Katerina_Vondrakova.png', alt: 'Skála' },
  { src: '/images/hero-clan-vondrakova.png', alt: 'HERO CLAN' },
];
---

<Layout title="Kateřina Vondráková" description="Weby, služby a strategie — Kateřina Vondráková, Jihlava">

  <!-- Hero -->
  <section class="hero-section grid-2col" style="max-width: 1100px; margin: 0 auto; padding: 60px 20px 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center;">
    <div>
      <h1 style="font-size: clamp(3rem, 7vw, 5.5rem); line-height: 1.05; margin: 0 0 24px; color: #bc2938;">
        Weby<br />Analýzy<br />Strategie
      </h1>
      <p style="font-size: 1.1rem; font-weight: 300; margin: 0 0 32px; color: #bc2938;">
        👩‍💻 Navrhuji a tvořím pro smysluplné projekty.
      </p>
      <a href="/portfolio-sluzeb" class="btn-default">PORTFOLIO SLUŽEB</a>
    </div>
    <div style="position: relative; overflow: hidden; border-radius: 8px;">
      <div id="hero-slider" style="position: relative; width: 100%; aspect-ratio: 1.658;">
        {slides.map((slide, i) => (
          <img
            src={slide.src}
            alt={slide.alt}
            class="slide"
            style={`position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 8px; opacity: ${i === 0 ? '1' : '0'}; transition: opacity 1s ease-in-out;`}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section" style="max-width: 1100px; margin: 0 auto; padding: 60px 20px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">

      <!-- Flekal -->
      <div class="speech-bubble">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: #bc2938; display: flex; align-items: center; justify-content: center; color: #fce6ef; font-weight: 600; font-size: 14px; flex-shrink: 0;">LF</div>
          <div>
            <p style="margin: 0; font-weight: 500; font-size: 14px; color: #bc2938;">Lukáš Flekal · 1st</p>
            <p style="margin: 0; font-size: 12px; color: #888; font-weight: 300;">Managing Director GOAT LABS</p>
          </div>
        </div>
        <p style="margin: 0; font-size: 14px; font-weight: 300; color: #333; line-height: 1.6;">
          Kateřina s námi dlouhodobě spolupracuje na UX designu konfigurátorů pro BROKIS. Její bohaté zkušenosti
          a hluboké znalosti v oblasti UX designu jsou znát. Dokáže analyzovat potřeby uživatelů i specifické
          požadavky projektu a vždy přicházet s kreativními a efektivními řešeními. Její přístup je precizní a promyšlený.
          Hodnotíme si velmi její spolehlivost a profesionalitu. Spolupráce s ní je vždy příjemná.
          Těšíme se na další!
        </p>
      </div>

      <!-- Kurka -->
      <div class="speech-bubble">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <div style="width: 40px; height: 40px; border-radius: 50%; background: #bc2938; display: flex; align-items: center; justify-content: center; color: #fce6ef; font-weight: 600; font-size: 14px; flex-shrink: 0;">JK</div>
          <div>
            <p style="margin: 0; font-weight: 500; font-size: 14px; color: #bc2938;">Jan Kurka · 1st</p>
            <p style="margin: 0; font-size: 12px; color: #888; font-weight: 300;">Co-founder and Impact Designer at SUSTO – Sustainability Tools</p>
          </div>
        </div>
        <p style="margin: 0; font-size: 14px; font-weight: 300; color: #333; line-height: 1.6;">
          A já bych chtěl dát tímto světu na vědomí, že zapojením Katky projekt nabral vyšší dynamiku.
          Je radost s Tebou spolupracovat, Katko!
        </p>
      </div>

    </div>
  </section>

  <!-- Přemýšlím -->
  <section class="content-section" style="max-width: 1100px; margin: 0 auto; padding: 40px 20px 80px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start;">
    <div>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 24px;">Přemýšlím</h2>
      <p style="font-size: 1rem; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0 0 32px;">
        Potřebuji chápat souvislosti a znát váš cíl a možnosti. Tak se ptám, zajímám se, navrhuji, tvořím,
        zjišťuji, testuji. Pojďme vymyslet strategii nebo službu. A vykopneme web za 3, 2, 1, teď.
      </p>
      <a href="/bio" class="btn-default">VÍC O MNĚ</a>
    </div>
    <div></div>
  </section>

  <!-- Spojme se -->
  <section id="spojme-se" class="content-section" style="max-width: 1100px; margin: 0 auto; padding: 80px 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; border-top: 2px solid #bc2938;">
    <div>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); margin: 0 0 24px;">🤝 Spojme se</h2>
      <p style="font-size: 1rem; font-weight: 300; line-height: 1.7; color: #bc2938; margin: 0 0 32px;">
        Máte zájem spolupracovat? Pojďme si dát krátkou schůzku / call, kde se seznámíme a řekneme si,
        zda naše spolupráce dává smysl.
      </p>
      <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
        <img src="/images/katerina_foto.png" alt="Kateřina Vondráková"
          style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; object-position: center 15%; border: 2px solid #bc2938;" />
        <div>
          <h3 style="font-size: 1.1rem; margin: 0 0 4px;">Ing. Kateřina Vondráková</h3>
          <p style="margin: 2px 0; font-size: 14px; font-weight: 300;">
            <a href="mailto:zeptamse@kateriny.cz" style="color: #bc2938;">zeptamse@kateriny.cz</a>
          </p>
          <p style="margin: 2px 0; font-size: 14px; font-weight: 300;">
            <a href="tel:+420721408001" style="color: #bc2938;">+420 721 408 001</a>
          </p>
        </div>
      </div>
      <!-- Social icons -->
      <div style="display: flex; gap: 12px;">
        <a href="https://www.linkedin.com/in/katerina-vondrakova/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/kateriny.cz/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/kateriny.tecka/" target="_blank" rel="noopener noreferrer"
          style="width: 36px; height: 36px; border: 2px solid #bc2938; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #bc2938; text-decoration: none;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
          </svg>
        </a>
      </div>
    </div>
    <div></div>
  </section>

</Layout>

<style>
  /* Page load fade-in */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-section {
    animation: fadeUp 0.7s ease-out both;
  }
  .testimonials-section {
    animation: fadeUp 0.7s ease-out 0.2s both;
  }
  .content-section {
    animation: fadeUp 0.7s ease-out 0.35s both;
  }

  /* Speech bubble */
  .speech-bubble {
    position: relative;
    background: #ffffff;
    border: 2px solid #bc2938;
    border-radius: 29px;
    padding: 28px 32px;
    color: #bc2938;
  }
  .speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -22px;
    left: 44px;
    border: 11px solid transparent;
    border-top-color: #bc2938;
  }
  .speech-bubble::before {
    content: '';
    position: absolute;
    bottom: -18px;
    left: 46px;
    border: 9px solid transparent;
    border-top-color: #ffffff;
    z-index: 1;
  }

  @media (max-width: 767px) {
    section[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLImageElement>('#hero-slider .slide');
  let current = 0;

  setInterval(() => {
    slides[current].style.opacity = '0';
    current = (current + 1) % slides.length;
    slides[current].style.opacity = '1';
  }, 3000);
</script>
