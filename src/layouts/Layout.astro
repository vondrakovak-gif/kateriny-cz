---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kateřina Vondráková — weby, analýzy, strategie' } = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Kateřiny</title>
    <meta property="og:title" content={`${title} | Kateřiny`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://kateriny.cz/images/OG_vondrakova.png" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://kateriny.cz/images/OG_vondrakova.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <style is:global>
      body { background-color: #fce6ef; color: #bc2938; font-family: 'Inter', Arial, sans-serif; font-weight: 300; }
      h1, h2, h3, h4 { font-family: 'Abril Fatface', cursive, Georgia, serif !important; font-weight: 400 !important; color: #bc2938; }
      @media (max-width: 767px) {
        .grid-3col { grid-template-columns: 1fr !important; }
        .grid-2col { grid-template-columns: 1fr !important; }
        .hide-mobile { display: none !important; }
        .img-hero { max-width: 100% !important; width: 100% !important; }
      }
      a { color: #bc2938; text-decoration: none; }
      a:hover { color: #7b1922; }
      .btn-default {
        display: inline-block;
        padding: 0.75em 1.6em;
        border: 2px solid #bc2938;
        border-radius: 30px;
        color: #bc2938;
        background: #fce6ef;
        font-size: 15px;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
      }
      .btn-default:hover { background: #bc2938; color: #fce6ef; }
      .btn-primary {
        display: inline-block;
        padding: 0.75em 1.6em;
        border: 2px solid #bc2938;
        border-radius: 30px;
        color: #fce6ef;
        background: #bc2938;
        font-size: 15px;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
      }
      .btn-primary:hover { background: #fce6ef; color: #bc2938; }
      .box-default {
        border: 2px solid #bc2938;
        border-radius: 29px;
        padding: 37px 34px;
        background: transparent;
        color: #bc2938;
      }
      .box-secondary {
        border: 2px solid #bc2938;
        border-radius: 29px;
        padding: 28px 46px;
        background: #ffffff;
        color: #bc2938;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
